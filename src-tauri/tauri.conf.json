{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "璇玑录",
  "version": "0.1.17",
  "identifier": "im.lyrastudio.xuanjilu",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "璇玑录 · 星骰工作室本地版",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "maximized": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost https: data: blob:; media-src 'self' data: blob:; connect-src 'self' https: http:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$EXE/data/images/**", "$EXE/data/images/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "天琴工作室（Lyra Studio）",
    "copyright": "© 2026 天琴工作室（Lyra Studio）· 海舟（Lyrazhou）",
    "shortDescription": "《璇玑录》——《星骰工作室》本地版",
    "longDescription": "《璇玑录》是一款本地优先的占星骰子占卜、训练与星语档案软件。",
    "resources": ["../public/backgrounds/*"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"],
        "installMode": "currentUser"
      }
    }
  }
}
